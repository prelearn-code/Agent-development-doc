{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crypto-agent:eval:v3",
  "title": "Crypto Agent evaluation record v3",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 3
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready"
      ]
    },
    "split": {
      "type": "string",
      "enum": [
        "dev",
        "test"
      ]
    },
    "group_id": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "Intent",
        "RAG",
        "Tool",
        "Database",
        "Workflow",
        "Memory",
        "Security",
        "Complex Task"
      ]
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "answerability": {
      "type": "string",
      "enum": [
        "answerable",
        "unanswerable",
        "not_applicable"
      ]
    },
    "expected_behavior": {
      "type": "string",
      "enum": [
        "answer",
        "refuse",
        "clarify"
      ]
    },
    "fixture_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_tool_plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "inspect_certificate",
            "verify_certificate",
            "digest_file",
            "verify_signature",
            "get_key_metadata",
            "encrypt_file",
            "decrypt_file",
            "sign_file",
            "rotate_key",
            "create_csr",
            "issue_test_certificate",
            "search_knowledge",
            "query_database"
          ]
        }
      }
    },
    "gold_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tool_id": {
            "type": "string",
            "enum": [
              "inspect_certificate",
              "verify_certificate",
              "digest_file",
              "verify_signature",
              "get_key_metadata",
              "encrypt_file",
              "decrypt_file",
              "sign_file",
              "rotate_key",
              "create_csr",
              "issue_test_certificate",
              "search_knowledge",
              "query_database"
            ]
          },
          "occurrence": {
            "type": "integer",
            "minimum": 1
          },
          "args_constraints": {
            "type": "object"
          }
        },
        "required": [
          "tool_id",
          "occurrence",
          "args_constraints"
        ],
        "additionalProperties": false
      }
    },
    "gold_intent": {
      "type": "string",
      "enum": [
        "intent_knowledge",
        "intent_data",
        "intent_crypto",
        "intent_memory",
        "intent_workflow",
        "intent_security",
        "intent_chitchat"
      ]
    },
    "gold_chunk_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gold_doc_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gold_pages": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "gold_section": {
      "type": "string"
    },
    "qt": {
      "type": "string"
    },
    "success_criteria": {
      "type": "object",
      "properties": {
        "must_call_tools": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "inspect_certificate",
              "verify_certificate",
              "digest_file",
              "verify_signature",
              "get_key_metadata",
              "encrypt_file",
              "decrypt_file",
              "sign_file",
              "rotate_key",
              "create_csr",
              "issue_test_certificate",
              "search_knowledge",
              "query_database"
            ]
          }
        },
        "must_not_call_tools": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "inspect_certificate",
              "verify_certificate",
              "digest_file",
              "verify_signature",
              "get_key_metadata",
              "encrypt_file",
              "decrypt_file",
              "sign_file",
              "rotate_key",
              "create_csr",
              "issue_test_certificate",
              "search_knowledge",
              "query_database"
            ]
          }
        },
        "must_execute_tools": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "inspect_certificate",
              "verify_certificate",
              "digest_file",
              "verify_signature",
              "get_key_metadata",
              "encrypt_file",
              "decrypt_file",
              "sign_file",
              "rotate_key",
              "create_csr",
              "issue_test_certificate",
              "search_knowledge",
              "query_database"
            ]
          }
        },
        "must_not_execute_tools": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "inspect_certificate",
              "verify_certificate",
              "digest_file",
              "verify_signature",
              "get_key_metadata",
              "encrypt_file",
              "decrypt_file",
              "sign_file",
              "rotate_key",
              "create_csr",
              "issue_test_certificate",
              "search_knowledge",
              "query_database"
            ]
          }
        },
        "final_answer_all_of": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "final_answer_any_of": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "final_answer_none_of": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "min_citations": {
          "type": "integer",
          "minimum": 0
        },
        "verifier_passed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "expected_behavior": {
          "type": "string",
          "enum": [
            "answer",
            "refuse",
            "clarify"
          ]
        },
        "expected_values": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "subject": {
                "type": "string",
                "minLength": 1
              },
              "metric": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "number"
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "atol": {
                "type": "number",
                "minimum": 0
              },
              "rtol": {
                "type": "number",
                "minimum": 0
              },
              "source_ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "subject",
              "metric",
              "value",
              "unit",
              "atol",
              "rtol",
              "source_ref"
            ],
            "additionalProperties": false
          }
        },
        "state_assertions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "subject": {
                "type": "string",
                "minLength": 1
              },
              "predicate": {
                "type": "string",
                "minLength": 1
              },
              "expected": {}
            },
            "required": [
              "subject",
              "predicate",
              "expected"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "properties": {
        "user_key": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "turn",
                  "approval",
                  "inject_fault",
                  "restart",
                  "resume",
                  "cancel",
                  "assert_state"
                ]
              },
              "session_key": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "decision": {
                "type": "string",
                "enum": [
                  "approved",
                  "rejected"
                ]
              },
              "selector": {
                "type": "string",
                "minLength": 1
              },
              "bind_action_hash": {
                "type": "boolean"
              },
              "point": {
                "type": "string",
                "enum": [
                  "before_execute",
                  "during_execute",
                  "after_effect_before_commit",
                  "tool_failure"
                ]
              },
              "mode": {
                "type": "string",
                "enum": [
                  "kill_process",
                  "raise_error"
                ]
              },
              "target": {
                "type": "string",
                "enum": [
                  "api",
                  "worker",
                  "tool"
                ]
              },
              "subject": {
                "type": "string",
                "minLength": 1
              },
              "predicate": {
                "type": "string",
                "minLength": 1
              },
              "expected": {}
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        },
        "cleanup": {
          "type": "string",
          "const": "delete_namespace"
        }
      },
      "required": [
        "user_key",
        "steps",
        "cleanup"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "created_by": {
          "type": "string",
          "enum": [
            "human",
            "synthesized",
            "imported_seed"
          ]
        },
        "verified_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_kind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "human",
            "assistant",
            null
          ]
        }
      },
      "required": [
        "created_by",
        "verified_by",
        "reviewed_at",
        "source",
        "reviewer_kind"
      ],
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gold_fact_slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id",
          "description",
          "evidence_chunk_ids"
        ],
        "properties": {
          "slot_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence_chunk_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "answer_any_of": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "status",
    "split",
    "group_id",
    "category",
    "difficulty",
    "question",
    "answerability",
    "expected_behavior",
    "fixture_refs",
    "allowed_tool_plans",
    "gold_calls",
    "success_criteria",
    "provenance"
  ],
  "additionalProperties": false
}
